<Page
    x:Class="ClientConvertisseurV2.Views.ConvertisseurDeviseEuroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <RelativePanel Padding="20">

        <TextBlock x:Name="Title"
               Text="Convertisseur Devise → Euro"
               FontSize="28"
               FontWeight="SemiBold"
               RelativePanel.AlignHorizontalCenterWithPanel="True"
               Margin="0,10,0,20"/>

        <TextBlock x:Name="LblDevise"
               Text="Devise :"
               FontSize="16"
               RelativePanel.Below="Title"
               RelativePanel.AlignHorizontalCenterWithPanel="True"
               Margin="0,0,0,6"/>

        <ComboBox x:Name="CmbDevises"
              Width="260"
              ItemsSource="{Binding Devises}"
              SelectedItem="{Binding DeviseSelectionnee, Mode=TwoWay}"
              DisplayMemberPath="Nom"
              PlaceholderText="Sélectionner une devise"
              RelativePanel.Below="LblDevise"
              RelativePanel.AlignHorizontalCenterWithPanel="True"
              Margin="0,0,0,18"/>

        <TextBlock x:Name="LblMontant"
               Text="Montant en devise :"
               FontSize="16"
               RelativePanel.Below="CmbDevises"
               RelativePanel.AlignHorizontalCenterWithPanel="True"
               Margin="0,0,0,6"/>

        <TextBox x:Name="TxtMontantDevise"
             Width="260"
             PlaceholderText="Ex : 100"
             Text="{Binding MontantDevise, Mode=TwoWay}"
             RelativePanel.Below="LblMontant"
             RelativePanel.AlignHorizontalCenterWithPanel="True"
             Margin="0,0,0,18"/>

        <Button x:Name="BtnConvertir"
            Content="Convertir"
            Width="260"
            Command="{Binding BtnSetConversion}"
            RelativePanel.Below="TxtMontantDevise"
            RelativePanel.AlignHorizontalCenterWithPanel="True"
            Margin="0,0,0,18"/>

        <TextBox x:Name="TxtEuro"
             Width="260"
             IsReadOnly="True"
             PlaceholderText="Montant en euros"
             Text="{Binding MontantEuro}"
             RelativePanel.Below="BtnConvertir"
             RelativePanel.AlignHorizontalCenterWithPanel="True"/>

    </RelativePanel>

</Page>
